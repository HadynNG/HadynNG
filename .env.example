# =============================================================================
# HadynNG Agentic KYC Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.

# ── LLM / Ollama ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3.5:9b
LLM_TEMPERATURE=0.05
LLM_MAX_TOKENS=2048
LLM_SEED=42

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hadynng
POSTGRES_USER=hadynng
POSTGRES_PASSWORD=changeme_in_production

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── MinIO (S3-compatible object store) ───────────────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=hadynng
MINIO_ROOT_PASSWORD=changeme_in_production
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_AUDIT=audit-logs
MINIO_BUCKET_TIMELINES=timelines

# ── Milvus (vector database) ─────────────────────────────────────────────────
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091
MILVUS_COLLECTION_MEMORY=agent_memory
MILVUS_COLLECTION_RAG=rag_documents

# ── Mission Broker (FastAPI) ────────────────────────────────────────────────
BROKER_HOST=0.0.0.0
BROKER_PORT=8000

# ── Tools MCP Server ─────────────────────────────────────────────────────────
TOOLS_MCP_HOST=0.0.0.0
TOOLS_MCP_PORT=8101

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
